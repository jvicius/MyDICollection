<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MyDICollection.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MyDICollection.MainPage"
             xmlns:helpers="clr-namespace:MyDICollection.Helpers"
             xmlns:responsive="clr-namespace:MyDICollection.Helpers.Responsive"
             xmlns:controls="clr-namespace:MyDICollection.Controls"
             xmlns:fonts="clr-namespace:MyDICollection.Helpers.Fonts"
             >

    <!-- ESTA ES LA MAGIA PARA LA BARRA SUPERIOR -->
    <Shell.TitleView>
        <!-- Un Grid de 3 columnas: Izquierda (Auto), Centro (* para rellenar), Derecha (Auto) -->
        <Grid 
            ColumnDefinitions="auto, *, auto" 
            VerticalOptions="Center" 
            Padding="{responsive:ResponsiveThickness BaseValue='0,0,10,0'}">

            <!-- 1. ICONO IZQUIERDO (Menú/Home) -->
            <Label Grid.Column="0" 
                Text="{x:Static fonts:FontAwesomeIcons.Menu}"
                Style="{StaticResource HomeMenuIconLabel}"
                HorizontalOptions="Center"
                VerticalOptions="Center"/>

            <!-- 2. TÍTULO CENTRADO -->
            <Label Grid.Column="1"
                   Text="{helpers:Translate Title}"
                   Style="{StaticResource TitleLabel}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" 
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"/>

            <!-- 3. ICONO DERECHO (Filtro) -->
            <Label Grid.Column="2" 
                Text="{x:Static fonts:FontAwesomeIcons.Filter}"
                Style="{StaticResource HomeMenuIconLabel}"
                HorizontalOptions="Center"
                VerticalOptions="Center"/>

        </Grid>
    </Shell.TitleView>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Sección de filtros -->
        <!--<Border 
            Margin="{responsive:ResponsiveThickness BaseValue='15,5,15,0'}"
            Style="{StaticResource FilterBorder}">

            <toolkit:Expander>

                <toolkit:Expander.Header>

                    <Grid 
                ColumnDefinitions="*,Auto"
                Padding="{responsive:ResponsiveThickness BaseValue='14,10'}">

                        <Label Text="{helpers:Translate Search}"
                       Style="{StaticResource FilterTitleLabel}"
                       VerticalOptions="Center"
                       HorizontalOptions="Start"/>

                    </Grid>

                </toolkit:Expander.Header>

                <VerticalStackLayout 
                Padding="{responsive:ResponsiveThickness BaseValue='14,4,14,14'}"
                Spacing="{responsive:ResponsiveSize BaseValue=10}">

                    <VerticalStackLayout Spacing="{responsive:ResponsiveSize BaseValue=2}">
                        <Label Text="{helpers:Translate Collect}" Style="{StaticResource FilterLabel}"/>
                        <Picker ItemsSource="{Binding OpcionesObtenido}"
            SelectedItem="{Binding FiltroObtenido}"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="{responsive:ResponsiveSize BaseValue=2}">
                        <Label Text="{helpers:Translate Type}" Style="{StaticResource FilterLabel}"/>
                        <Picker ItemsSource="{Binding OpcionesTipo}"
            SelectedItem="{Binding FiltroTipo}"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="{responsive:ResponsiveSize BaseValue=2}">
                        <Label Text="{helpers:Translate Version}" Style="{StaticResource FilterLabel}"/>
                        <Picker ItemsSource="{Binding OpcionesVersion}"
            SelectedItem="{Binding FiltroVersion}"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="{responsive:ResponsiveSize BaseValue=2}">
                        <Label Text="{helpers:Translate Brand}" Style="{StaticResource FilterLabel}"/>
                        <Picker ItemsSource="{Binding OpcionesFranquicia}"
            SelectedItem="{Binding FiltroFranquicia}"/>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </toolkit:Expander>
        </Border>-->

        <Grid Grid.Row="1" ColumnDefinitions="*, *" ColumnSpacing="15" Margin="{responsive:ResponsiveThickness BaseValue='15,5,15,10'}">

            <!-- ETIQUETA 1: INVENTARIO FÍSICO (Incluye repetidas) -->
            <Border Grid.Column="0" 
                Style="{StaticResource BorderInfo}">

                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                    <!-- Icono -->
                    <Label Text="{x:Static fonts:FontAwesomeIcons.Boxes}" 
                        Style="{StaticResource BorderInfoIcon}"
                        VerticalOptions="Center" />

                    <Label Text="Piezas:" 
                        Style="{StaticResource BorderInfoLabel}"
                        VerticalOptions="Center" />

                    <Label Text="{Binding TotalPiezasFisicas}" 
                        Style="{StaticResource BorderInfoLabel}"
                        FontAttributes="Bold"
                        VerticalOptions="Center" />
                    
                </HorizontalStackLayout>
                
            </Border>

            <!-- ETIQUETA 2: PROGRESO DE COLECCIÓN (Únicas) -->
            <Border Grid.Column="1" 
                Style="{StaticResource BorderInfo}">

                <VerticalStackLayout Spacing="4" VerticalOptions="Center" HorizontalOptions="Fill">

                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">

                        <!-- Icono -->
                        <Label Text="{x:Static fonts:FontAwesomeIcons.Figura2}" 
                            Style="{StaticResource BorderInfoIcon2}"
                            VerticalOptions="Center"/>

                        <Label Text="Únicas:" 
                        Style="{StaticResource BorderInfoLabel2}"
                        VerticalOptions="Center" />

                        <Label Text="{Binding TextoProgresoColeccion}" 
                        Style="{StaticResource BorderInfoLabel2}"
                        FontAttributes="Bold" 
                        VerticalOptions="Center" />

                    </HorizontalStackLayout>

                    <ProgressBar Progress="{Binding PorcentajeColeccion}" 
                         Style="{StaticResource BorderInfoProgrees}"/>

                </VerticalStackLayout>

            </Border>

        </Grid>

        <!-- Loader -->
        <ActivityIndicator Grid.Row="2"
                            IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"/>

        <!-- Lista de figuras -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Figures}"
                        IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        Margin="{responsive:ResponsiveThickness BaseValue='15,0,15,15'}"
                        HorizontalScrollBarVisibility="Never"
                        VerticalScrollBarVisibility="Never">
            
            <CollectionView.ItemsLayout>
                
                <LinearItemsLayout 
                    Orientation="Vertical" 
                    ItemSpacing="{responsive:ResponsiveSize BaseValue=12}"/>
                
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                
                <DataTemplate x:DataType="models:FiguraModel">
                    
                    <Grid 
                        Padding="{responsive:ResponsiveThickness BaseValue='0,10,10,0'}">
                        
                        <Border 
                                Padding="{responsive:ResponsiveThickness BaseValue='12'}"
                                Style="{StaticResource CardBorder}">

                            <Grid 
                                ColumnDefinitions="Auto,*" 
                                ColumnSpacing="{responsive:ResponsiveSize BaseValue=14}">

                                <Border Grid.Column="0"
                                        Style="{StaticResource ImageCardBorder}"
                                        HeightRequest="{responsive:ResponsiveSize BaseValue=95}"
                                        WidthRequest="{responsive:ResponsiveSize BaseValue=95}"
                                        Padding="0">
                                    
                                    <Image Source="{Binding ImagenUrl}"
                                           Aspect="AspectFit"
                                           HeightRequest="{responsive:ResponsiveSize BaseValue=90}"
                                           WidthRequest="{responsive:ResponsiveSize BaseValue=90}"/>

                                </Border>

                                <VerticalStackLayout 
                                    Grid.Column="1" 
                                    Spacing="{responsive:ResponsiveSize BaseValue=2}" 
                                    VerticalOptions="Center">

                                    <Label Text="{Binding Nombre}"
                                           Style="{StaticResource FiguraTitleLabel}"/>

                                    <Label>
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Tipo}" Style="{StaticResource FiguraVersionSpan}"/>
                                                <Span Text=" · v" Style="{StaticResource FiguraVersionSpan}" />
                                                <Span Text="{Binding Version}" Style="{StaticResource FiguraVersionSpan}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <Label Text="{Binding Franquicia}"
                                           Style="{StaticResource FiguraFranquiciaLabel}"
                                           />

                                    <HorizontalStackLayout 
                                        Spacing="{responsive:ResponsiveSize BaseValue=10}" 
                                        Margin="{responsive:ResponsiveThickness BaseValue='0,8,0,0'}">

                                        <controls:HexagonButton Text="{x:Static fonts:FontAwesomeIcons.Minus}"
                                            Style="{StaticResource CardActionHexaButtonA}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DecrementarCommand}"
                                            CommandParameter="{Binding .}"/>

                                        <controls:HexagonButton Text="{x:Static fonts:FontAwesomeIcons.Plus}"
                                             Style="{StaticResource CardActionHexaButtonB}"
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.IncrementarCommand}"
                                             CommandParameter="{Binding .}"/>

                                        <controls:HexagonButton Text="{x:Static fonts:FontAwesomeIcons.Web}"
                                             Style="{StaticResource CardActionHexaButtonC}"
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AbrirWikiCommand}"
                                             CommandParameter="{Binding .}"/>

                                        <!--<controls:HexagonButton Text="{x:Static fonts:FontAwesomeIcons.Sync}"
                                               Style="{StaticResource CardActionHexaButtonD}"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AbrirWikiCommand}"
                                               CommandParameter="{Binding .}"/>-->

                                    </HorizontalStackLayout>

                                </VerticalStackLayout>
                                
                            </Grid>
                            
                        </Border>

                        <Border IsVisible="{Binding Obtenido}"
                                Style="{StaticResource ObtenidoBorder}"
                                Padding="{responsive:ResponsiveThickness BaseValue='10,5'}"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                Margin="{responsive:ResponsiveThickness BaseValue='0,-10,-10,0'}"
                                >
                            
                            <Border.Shadow>
                                <Shadow Brush="{AppThemeBinding Light={StaticResource Gray950Brush}, Dark={StaticResource Gray100Brush}}" Opacity="{AppThemeBinding Light=0.3, Dark=0.7}" Radius="6" Offset="0,2"/>
                            </Border.Shadow>
                            
                            <Label Text="{Binding Cantidad, StringFormat='✓ x{0}'}"
                                   Style="{StaticResource ObtenidoIndicatorLabel}"/>
                            
                        </Border>

                        <Border IsVisible="{Binding Obtenido, Converter={StaticResource InvertedBoolConverter}}"
                                Style="{StaticResource NoObtenidoBorder}"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                Margin="{responsive:ResponsiveThickness BaseValue='0,-10,-10,0'}"
                                Padding="0"
                                >
                            
                            <Border.Shadow>

                                <Shadow Brush="{AppThemeBinding Light={StaticResource Gray950Brush}, Dark={StaticResource Gray100Brush}}" Opacity="{AppThemeBinding Light=0.3, Dark=0.7}" Radius="6" Offset="0,2"/>
                                
                            </Border.Shadow>
                            
                            <Label Text="0"
                                   Style="{StaticResource ObtenidoIndicatorLabel}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"/>
                            
                        </Border>
                        
                    </Grid>
                    
                </DataTemplate>
                
            </CollectionView.ItemTemplate>

        </CollectionView>
        
        <!--Menu Inferior-->

        <Grid 
            Grid.Row="3" 
            VerticalOptions="End" 
            Style="{StaticResource MenuGrid}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{StaticResource MenuHeight}"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- EFECTO CUTOUT: Círculo blanco detrás del botón verde para simular la curva de la barra -->
            <Border Grid.Column="2" 
                Style="{StaticResource MenuCenterBorder}"
                Padding="0"
                VerticalOptions="Start"
                HorizontalOptions="Center" 
                />
            <!-- Sube un poquito más allá del fondo -->

            <!-- BOTÓN CENTRAL -->
            
            <!-- EFECTO CUTOUT (El fondo blanco se queda igual) -->
            <Border Grid.Column="2" 
                Style="{StaticResource MenuCenterBorder}"
                Padding="0"
                VerticalOptions="Start"
                HorizontalOptions="Center" />

            <!-- TU NUEVO BOTÓN CENTRAL -->
            <controls:CenterMenuButton Grid.Column="2"
                           ImageSource="none.png"
                           Command="{Binding AbrirMenuAsync}"
                           CommandParameter="Home" />


            <controls:MenuTabItem Grid.Column="0"
                IconText="{x:Static fonts:FontAwesomeIcons.Figura2}"
                LabelText="{helpers:Translate MyFigures}"
                Style="{StaticResource MenuTabItemStyle}"
                IsSelected="{Binding SelectedMenuFigures}" 
                Command="{Binding AbrirMenuCommand}"
                CommandParameter="MyFigures" />

            <controls:MenuTabItem Grid.Column="1"
                IconText="{x:Static fonts:FontAwesomeIcons.PowerDisc3}"
                LabelText="{helpers:Translate MyDiscs}"
                Style="{StaticResource MenuTabItemStyle}"
                IsSelected="{Binding SelectedMenuDiscs}" 
                Command="{Binding AbrirMenuCommand}"
                CommandParameter="MyDiscs" />


            <controls:MenuTabItem Grid.Column="3"
               IconText="{x:Static fonts:FontAwesomeIcons.Trophy}"
               LabelText="{helpers:Translate Achievements}"
               Style="{StaticResource MenuTabItemStyle}"
               IsSelected="{Binding SelectedMenuArchi}" 
               Command="{Binding AbrirMenuCommand}"
               CommandParameter="Achievements" />


            <controls:MenuTabItem Grid.Column="4"
                IconText="{x:Static fonts:FontAwesomeIcons.Settings}"
                LabelText="{helpers:Translate Settings}"
                Style="{StaticResource MenuTabItemStyle}"
                IsSelected="{Binding SelectedMenuSettings}" 
                Command="{Binding AbrirMenuCommand}"
                CommandParameter="Settings" />

        </Grid>

    </Grid>
    
</ContentPage>