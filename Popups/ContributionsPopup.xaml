<?xml version="1.0" encoding="utf-8" ?>
<mopups:PopupPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
             xmlns:animations="clr-namespace:Mopups.Animations;assembly=Mopups"
             xmlns:responsive="clr-namespace:MyDICollection.Helpers.Responsive"
             xmlns:controls="clr-namespace:MyDICollection.Controls"
             xmlns:fonts="clr-namespace:MyDICollection.Helpers.Fonts"
             xmlns:viewmodels="clr-namespace:MyDICollection.ViewModels"
             xmlns:helpers="clr-namespace:MyDICollection.Helpers"
             x:Class="MyDICollection.Popups.ContributionsPopup"
             x:DataType="viewmodels:ContributionsViewModel"
             BackgroundColor="#80000000">

    <mopups:PopupPage.Animation>
        <animations:ScaleAnimation PositionIn="Center" PositionOut="Center" DurationIn="200" DurationOut="200"/>
    </mopups:PopupPage.Animation>

    <controls:SafeAreaView>

        <Grid HorizontalOptions="Center" 
          VerticalOptions="Center" 
          Padding="{responsive:ResponsiveThickness BaseValue='20'}">

            <Border Style="{StaticResource BorderPopup}">

                <VerticalStackLayout 
                Spacing="{responsive:ResponsiveSize BaseValue=15}" 
                HorizontalOptions="Center">

                    <!-- Ícono de Handshake (Apretón de manos) -->
                    <Label Text="{x:Static fonts:FontAwesomeIcons.Handshake}"         
                       HorizontalOptions="Center"
                       Style="{StaticResource InfoIconLabel}" />

                    <!-- Título -->
                    <Label Text="{helpers:Translate MenuContributions}" 
                       Style="{StaticResource InfoTitleLabel}"
                       HorizontalOptions="Center" />

                    <!-- Divisor estético -->
                    <BoxView HeightRequest="1" 
                         Color="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource White}}" 
                         Opacity="0.2" 
                         Margin="{responsive:ResponsiveThickness BaseValue='5,0'}"/>

                    <!-- Texto amigable de invitación -->
                    <Label Text="{helpers:Translate ContributionsMessage}"
                       HorizontalTextAlignment="Center"
                       Style="{StaticResource InfoLegalLabel}"
                       Margin="{responsive:ResponsiveThickness BaseValue='0,0,0,10'}"/>

                    <!-- Botón GitHub Sponsors -->
                    <Button Text="GitHub Sponsors"
                        Command="{Binding AbrirGitHubSponsorsCommand}"
                        Style="{StaticResource InfoButton1}"
                        Margin="{responsive:ResponsiveThickness BaseValue='0,5'}"/>

                    <!-- Botón Ko-Fi -->
                    <Button Text="Ko-fi"
                        Command="{Binding AbrirKoFiCommand}"
                        Style="{StaticResource InfoButton2}"
                        Margin="{responsive:ResponsiveThickness BaseValue='0,0,0,10'}"/>

                    <!-- Botón de Cerrar -->
                    <controls:HexagonButton Text="{x:Static fonts:FontAwesomeIcons.Close}" 
                    Style="{StaticResource HexaButton}">
                        <controls:HexagonButton.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CerrarCommand}"/>
                        </controls:HexagonButton.GestureRecognizers>
                    </controls:HexagonButton>

                </VerticalStackLayout>
            </Border>
        </Grid>

    </controls:SafeAreaView>
    
</mopups:PopupPage>