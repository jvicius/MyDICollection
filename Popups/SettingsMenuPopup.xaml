<?xml version="1.0" encoding="utf-8" ?>
<mopups:PopupPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
             xmlns:viewmodels="clr-namespace:MyDICollection.ViewModels"
             xmlns:controls="clr-namespace:MyDICollection.Controls"
             xmlns:fonts="clr-namespace:MyDICollection.Helpers.Fonts"
             x:Class="MyDICollection.Popups.SettingsMenuPopup"
             x:DataType="viewmodels:SettingsMenuViewModel"
             BackgroundColor="#80000000"
             CloseWhenBackgroundIsClicked="True">

    <controls:SafeAreaView>

        <!-- Contenedor alineado a la derecha, alto completo -->
        <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
            HorizontalOptions="End"
            VerticalOptions="Fill"
            WidthRequest="250"
            StrokeShape="RoundRectangle 25, 0, 0, 25" 
            Margin="0"
            Padding="20">
            <!-- El StrokeShape (IzquierdaArriba, DerechaArriba, DerechaAbajo, IzquierdaAbajo) redondea solo el lado izquierdo -->

            <VerticalStackLayout Spacing="15" Margin="0,50,0,0">

                <Label Text="Configuración" 
                   FontSize="22" 
                   FontAttributes="Bold" 
                   Margin="0,0,0,20"/>

                <!-- Botones que mandan el string por CommandParameter -->
                <Button Text="Lenguaje" 
                    Command="{Binding SeleccionarOpcionCommand}" 
                    CommandParameter="Lenguaje"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=Black, Dark=White}"
                    HorizontalOptions="Start"/>

                <Button Text="Contribuir" 
                    Command="{Binding SeleccionarOpcionCommand}" 
                    CommandParameter="Contribuir"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=Black, Dark=White}"
                    HorizontalOptions="Start"/>

                <Button Text="Acerca del App" 
                    Command="{Binding SeleccionarOpcionCommand}" 
                    CommandParameter="AcercaDe"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=Black, Dark=White}"
                    HorizontalOptions="Start"/>

            </VerticalStackLayout>
        </Border>

    </controls:SafeAreaView>
</mopups:PopupPage>